# Required — set these in Netlify: Site configuration > Environment variables
GROQ_API_KEY=gsk_your_groq_key
JINA_API_KEY=jina_your_jina_key

# Optional overrides (defaults shown)
# GROQ_ROUTER_MODEL=openai/gpt-oss-20b
# GROQ_GENERATOR_MODEL=openai/gpt-oss-120b
# GROQ_ENRICH_MODEL=openai/gpt-oss-20b
# GROQ_CONFLICT_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low          # low | medium | high (generator + conflict audit)
# JINA_EMBED_MODEL=jina-embeddings-v5-text-small
# JINA_RERANK_MODEL=jina-reranker-v3
# JINA_EMBED_DIMS=1024
