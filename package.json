{
  "name": "almamlaka-rag-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Almamlaka TV RAG chatbot: LangGraph.js on Netlify Functions, Groq LLMs, Jina embeddings + reranker.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "echo \"Static frontend: nothing to build. Functions are bundled by Netlify.\"",
    "dev": "netlify dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "extract": "node scripts/extract-pdfs.mjs",
    "eval": "node --import tsx scripts/eval.ts",
    "serve": "node --import tsx scripts/dev-server.ts",
    "serve:mock": "node --import tsx scripts/dev-server.ts --mock"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.5.0",
    "@netlify/blobs": "^11.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
