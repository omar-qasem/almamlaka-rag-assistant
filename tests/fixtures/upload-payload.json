      {
       "text": "4. Data Privacy Policy",
       "cells": null,
       "x": 78,
       "y": 710.4,
       "h": 18,
       "font": "g_d2_f2",
       "dir": "ltr"
      },
      {
       "text": "All user data collected through the mobile application and streaming portal will be handled in",
       "cells": null,
       "x": 78,
       "y": 687.9,
       "h": 10.5,
       "font": "g_d2_f1",
       "dir": "ltr"
      },
      {
       "text": "accordance with applicable data protection regulations. User data will not be shared with third",
       "cells": null,
       "x": 78,
       "y": 672.9,
       "h": 10.5,
       "font": "g_d2_f1",
       "dir": "ltr"
      },
      {
       "text": "parties without explicit consent, except where required by law.",
       "cells": null,
       "x": 78,
       "y": 657.9,
       "h": 10.5,
       "font": "g_d2_f1",
       "dir": "ltr"
      },
      {
       "text": "5. Content Moderation Policy",
       "cells": null,
       "x": 78,
       "y": 621.4,
       "h": 18,
       "font": "g_d2_f2",
       "dir": "ltr"
      },
      {
       "text": "User-generated comments and interactions on the platform are subject to Almamlaka TV's content",
       "cells": null,
       "x": 78,
       "y": 598.9,
       "h": 10.5,
       "font": "g_d2_f1",
       "dir": "ltr"
